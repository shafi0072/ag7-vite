    "label": "string | undefined (overrides default text)",
    "size": "StatusIcon only, px"
  },
  "states": {
    "pending": {
      "status": "pending"
    },
    "running": {
      "status": "running"
    },
    "success": {
      "status": "success"
    },
    "error": {
      "status": "error"
    },
    "skipped": {
      "status": "skipped"
    }
  }
}
